{
  "name": "a2b-logistics",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "architecture:generate": "node scripts/generate-architecture-map.mjs",
    "architecture:check": "node scripts/generate-architecture-map.mjs --check",
    "markdown:generate": "node scripts/generate-markdown-companions.mjs",
    "markdown:check": "node scripts/generate-markdown-companions.mjs --check",
    "markdown:validate": "node scripts/validate-markdown-layer.mjs",
    "markdown:validate:live": "node scripts/validate-live-markdown-layer.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "test:whatsapp": "node scripts/test-whatsapp-analytics.mjs",
    "security:check": "node scripts/verify-security-baseline.mjs",
    "verify": "node scripts/verify-site.mjs && npm run security:check",
    "ai:benchmark": "node scripts/ai-visibility-benchmark.mjs",
    "agent:report": "node scripts/agent-analytics-report.mjs",
    "agent:concierge:test": "node scripts/validate-agent-concierge.mjs",
    "agent:concierge:report": "node scripts/agent-concierge-report.mjs",
    "health:check": "node scripts/check-production-health.mjs",
    "health:test": "node scripts/validate-production-health.mjs",
    "agent:metrics:retain": "node scripts/retain-concierge-metrics.mjs",
    "agent:metrics:test": "node scripts/validate-concierge-metrics.mjs",
    "quality:check": "node scripts/verify-experience-quality.mjs && node scripts/test-form-drafts.mjs",
    "release:verify": "node scripts/verify-live-release.mjs",
    "agent:answers:review": "node scripts/review-concierge-answers.mjs --write",
    "agent:answers:check": "node scripts/review-concierge-answers.mjs",
    "agent:answers:test": "node scripts/test-approved-concierge-answers.mjs"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  }
}
